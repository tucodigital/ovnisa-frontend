# --- SMTP del form de contacto (POST /api/contact) ---------------------------
# Resend, via SMTP: sigue usando nodemailer, no hace falta su SDK. El usuario
# es literalmente "resend" y la password es la API key (re_...).
#
# Sin prefijo NEXT_PUBLIC_: con ese prefijo Next las inyecta en el bundle que
# baja el navegador y la API key queda publica.
#
# Si el hosting bloquea el 465, sirve el 587 o el 2587: el codigo pasa a
# STARTTLS solo y con requireTLS no manda si el server no ofrece TLS.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=
# Remitente. Tiene que ser una direccion del dominio verificado en Resend, pero
# la casilla no necesita existir: landingsredirect@tucodigital.com sigue sirviendo aunque se de de
# baja en Hostinger. Obligatorio, el endpoint responde 500 si falta.
SMTP_FROM=Ovnisa <landingsredirect@tucodigital.com>
# Casilla que recibe los mensajes. Antes se llamaba SMTP_CONTACTEMAIL:
# HAY QUE RENOMBRARLA EN EL PANEL DEL HOSTING.
SMTP_TO=
